{
  "manifest_version": 3,
  "name": "X AI Reply",
  "version": "5.0",
  "description": "Context-locked multilingual AI Reply for X with Vision, Quick Angles, Multi-Profile & Translation Preview.",
  "permissions": ["storage"],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "X AI Reply"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pro.x.com/*",
    "https://api.x.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://pro.x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
